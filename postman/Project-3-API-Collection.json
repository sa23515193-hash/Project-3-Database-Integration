{
  "info": {
    "name": "Project 3 - Database Integration API",
    "description": "CRUD API collection for the Industrial Training Kit Project 3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "itemId",
      "value": "REPLACE_WITH_ITEM_ID"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Create Item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Bluetooth headphones with noise cancellation\",\n  \"price\": 8500,\n  \"category\": \"Electronics\",\n  \"inStock\": true\n}"
        },
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "Get All Items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "Get Single Item",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    },
    {
      "name": "Update Item",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Premium Wireless Headphones\",\n  \"price\": 9500,\n  \"category\": \"Electronics\",\n  \"inStock\": true\n}"
        },
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    },
    {
      "name": "Delete Item",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    }
  ]
}